+// Compares "Bearer <key>" without stopping at the first differing byte.
+static bool api_key_matches(const std::string& authorization, const std::string& key) {
+    const std::string expected = "Bearer " + key;
+    if (authorization.size() != expected.size()) {
+        return false;
+    }
+    unsigned char diff = 0;
+    for (size_t i = 0; i < expected.size(); i++) {
+        diff |= static_cast<unsigned char>(authorization[i] ^ expected[i]);
+    }
+    return diff == 0;
+}
